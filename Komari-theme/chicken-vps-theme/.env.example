# 公开 Komari 部署时，.env 不是必需文件。
# 公开接口不需要管理员 Key 或探针 Token；私有 Komari 的 API Key 配置见下方注释。
#
# 如果想保留一个统一的 Docker 配置文件，可以复制：
#   cp .env.example .env
#   chmod 600 .env
# 但下面的最小 docker run 不使用 --env-file，也可以完全不创建 .env。

# 只有以后启用其他探针适配器时才需要；Komari-only 部署保持注释即可。
# SERVER_STATUS_TOKEN=
# NEZHA_TOKEN=

# 私有 Komari 才需要：填写 Komari API Key 的原始值，不要在主题设置中填写。
# Bridge 会自动发送 Authorization: Bearer <KOMARI_API_KEY>。
KOMARI_API_KEY=

# Compose 专用。复制后建议改成当前部署用户的实际 UID/GID：
#   id -u
#   id -g
DOCKER_UID=1000
DOCKER_GID=1000

# 以下是可选的运行时覆盖项，通常不需要改。
# Docker 发布端口时 HOST 必须保持 0.0.0.0，不能改成 127.0.0.1。
# HOST=0.0.0.0
# PORT=3777
# CONFIG_PATH=/app/bridge/config.json

# 只有在 trustedProxyCidrs 已填写实际反向代理地址，并且需要信任
# X-Forwarded-For 时才打开。普通 Komari + Nginx 部署可以保持关闭。
# TRUST_PROXY=1
