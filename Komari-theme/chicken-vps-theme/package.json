{
  "name": "chicken-vps-komari-theme-template",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Single-ZIP Komari theme with an optional game-only multiplayer Bridge.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "bridge": "node bridge/server/index.js",
    "test": "node --test bridge/test/*.test.mjs",
    "package": "npm run build && node scripts/package-theme.mjs"
  },
  "dependencies": {
    "maxmind": "^4.3.18",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "three": "^0.172.0"
  },
  "engines": {
    "node": ">=22"
  }
}
